{% macro render(grid, live = false) %}
    {% set definition = grid.definition %}

    <table>
        <thead>
        <tr>
            {% for field in definition.fields %}
                {% if field.enabled %}
                    <th class="sylius-table-column-{{ field.name }} {{ field.options.vars.th_class|default('') }}">{{ field.label|trans }}</th>
                {% endif %}
            {% endfor %}
            {% if definition.actionGroups.item is defined and definition.getEnabledActions('item')|length > 0 %}
                <th class="sylius-table-column-actions">Actions</th>
            {% endif %}
        </tr>
        </thead>
        <tbody>
        {% for resource in grid.data %}
            <tr>
                {% for field in definition.enabledFields %}
                    <td data-test-{{ field.name }}>{{ sylius_grid_render_field(grid, field, resource) }}</td>
                {% endfor %}
                {% if definition.actionGroups.item is defined and definition.getEnabledActions('item')|length > 0 %}
                    <td>
                        {% for action in definition.getEnabledActions('item') %}
                            {{ sylius_grid_render_action(grid, action, resource) }}
                        {% endfor %}
                    </td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <br />

    {% set paginator = grid.data %}

    {% if paginator.haveToPaginate() %}
        {{ pagerfanta(paginator, 'twig', options|default({'template': live ? 'shared/helper/live_pagination.html.twig' : '@BabDevPagerfanta/default.html.twig'})) }}
    {% endif %}
{% endmacro %}

{% macro render_filters(grid) %}
    {% set definition = grid.definition %}

    <form method="get">
        {% for filter in definition.enabledFilters %}
            {{ sylius_grid_render_filter(grid, filter) }}
        {% endfor %}
        <input type="submit" value="Filter" />
    </form>
{% endmacro %}

