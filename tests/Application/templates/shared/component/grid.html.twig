{% import 'shared/helper/grid.html.twig' as grid_helper %}
{% import _self as self %}

<div {{ attributes }}>
    {% if withFilters %}
        {% for filter in filters %}
            {{ sylius_grid_render_filter(grid, filter) }}
        {% endfor %}
        <button data-action="live#action"
                data-live-action-param="resetFilters"
        >Reset</button>

        <br />
    {% endif %}

    Current page: {{ this.page|default(1) }}<br />
    Current limit: {{ this.limit|default(10) }}<br />

    <strong>Page limit: </strong>

    {{ self.change_limit_button(10, this.limit) }}
    {{ self.change_limit_button(25, this.limit) }}
    {{ self.change_limit_button(50, this.limit) }}

    {{ grid_helper.render(grid, true) }}
</div>

{% macro change_limit_button(limit, currentLimit) %}
    <button data-action="live#action"
            data-live-action-param="changeLimit"
            data-live-limit-param="{{ limit }}"
            {% if currentLimit|default(10) == limit %}disabled{% endif %}
    >{{ limit }}</button>
{% endmacro %}
